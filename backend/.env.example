ENV=development

# Leave as sqlite for zero-setup local dev, or point at Postgres (e.g. via docker-compose):
DATABASE_URL=sqlite:///./gradustry.db
# DATABASE_URL=postgresql+psycopg2://gradustry:gradustry@localhost:5432/gradustry

JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# --- Optional AI provider ---
# Leave AI_PROVIDER=none (default) and every AI feature runs on its
# deterministic fallback — no key required, nothing crashes.
AI_PROVIDER=none
# AI_PROVIDER=gemini
# AI_API_KEY=your-gemini-or-openai-key
# AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=2

# Optional: raises GitHub's unauthenticated rate limit for the GitHub Analyzer
GITHUB_TOKEN=
